{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NowChameh Poets Dataset",
  "description": "Schema for the Persian poetry poets dataset.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "bio",
      "birth_year",
      "death_year"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "bio": {
        "type": "string"
      },
      "birth_year": {
        "type": [
          "integer",
          "null"
        ]
      },
      "death_year": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  }
}

